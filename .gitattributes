# Normalize text files to LF (LF in both the repo and the working tree)
* text=auto eol=lf

# Windows scripts keep CRLF (needed by cmd/PowerShell)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: no conversion of any kind
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary

